# Copia este archivo como .env (el .env NO se sube a GitHub) y rellénalo.

# Clave secreta: obligatoria y aleatoria (mín. 32 caracteres) cuando DEBUG=False.
# Generar una:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=pon-aqui-una-clave-larga-y-secreta

# En tu equipo de desarrollo: True. En producción: False (o no definirlo).
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- MongoDB ---
# Atlas (cambia USUARIO, CLAVE y el host por los de tu clúster; si la clave tiene @ : / ? # % hay que codificarla):
# MONGODB_URI=mongodb+srv://USUARIO:CLAVE@tu-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority&serverSelectionTimeoutMS=5000
# Local:
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=patitas_amigables
# Para comprobar la conexión:  python manage.py probar_conexion

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Opcionales ---
# MAX_FOTO_MB=10            # peso máximo de cada foto subida
# LOG_LEVEL=INFO
# Solo producción (DEBUG=False):
# FORZAR_HTTPS=True         # redirige a HTTPS y marca las cookies como seguras
# HSTS_SEGUNDOS=3600        # súbelo (p. ej. 31536000) cuando HTTPS esté probado
# DETRAS_DE_PROXY=False     # True si hay nginx/Render/Railway delante
